generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  RESOLVER
}

enum QuestionStatus {
  PENDING
  ACTIVE
  CLOSED
  RESOLVED
  ARCHIVED
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())

  // Demographics
  neighborhood    String?
  ward            String?
  ageRange        String?
  gender          String?
  raceEthnicity   String?
  occupation      String?
  attendsMeetings String?
  interests       String?
  emailSubscribed Boolean  @default(false)

  predictions   Prediction[]
  comments      Comment[]
  submissions   Question[]   @relation("SubmittedBy")
  approvals     Question[]   @relation("ApprovedBy")
  resolutions   Outcome[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Question {
  id          String         @id @default(cuid())
  title       String
  description String?
  category    String?
  sourceUrl   String?
  sourceText  String?
  status      QuestionStatus @default(PENDING)
  closeAt     DateTime?      // deadline for predictions
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  options     Option[]
  predictions Prediction[]
  comments    Comment[]
  outcome     Outcome?
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  label      String  // e.g. "Yes", "No", "Passes", "Fails"

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  predictions Prediction[]
  desires     Prediction[] @relation("DesiredOption")
  outcome     Outcome?
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  optionId   String
  desiredId  String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
  option   Option   @relation(fields: [optionId], references: [id])
  desired  Option?  @relation("DesiredOption", fields: [desiredId], references: [id])

  @@unique([userId, questionId]) // one prediction per user per question
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  body       String
  url        String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Outcome {
  id          String   @id @default(cuid())
  questionId  String   @unique
  optionId    String   @unique
  resolvedAt  DateTime @default(now())
  notes       String?

  resolvedById String
  resolvedBy   User   @relation(fields: [resolvedById], references: [id])

  question Question @relation(fields: [questionId], references: [id])
  option   Option   @relation(fields: [optionId], references: [id])
}

// Board & Commission Accountability Case Studies
model BoardCaseStudy {
  id        String   @id @default(cuid())
  slug      String   @unique
  boardName String
  category  String   @default("Other")
  date      String   @default("")
  published Boolean  @default(false)
  summary   String   @default("") @db.Text

  // {value: string, label: string}[]
  stats       Json @default("[]")
  // {num: number, name: string, violation: string, evidence: string}[]
  principles  Json @default("[]")
  // {question: string, before: string, after: string, assessment: string}[]
  ownership   Json @default("[]")
  // {dimension: string, impact: string, description: string}[]
  bottomLines Json @default("[]")
  // {eyebrow: string, heading: string, description: string, items: {label: string, desc: string}[]}[]
  sections    Json @default("[]")
  // string[]
  recommendations Json @default("[]")
  sources         Json @default("[]")
  sourceUrls      Json @default("[]")

  // key entities, boards, commissions, and players involved
  players String[] @default([])
  // Lansing neighborhoods this case's addresses/impact fall within
  neighborhoods String[] @default([])

  scoreTransparency      String @default("insufficient")
  scoreConflicts         String @default("insufficient")
  scoreMission           String @default("insufficient")
  scoreDemocraticControl String @default("insufficient")
  scoreOversight         String @default("insufficient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lansing appointed boards and commissions directory
model Board {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  notes     String?
  sortOrder Int           @default(0)
  members   BoardMember[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BoardMember {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  termExpires String?
  status      String   @default("current") // current, vacant, proposed, expired
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lansing neighborhood organizations directory (59 registered + hubs)
model NeighborhoodOrg {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  name      String
  area      String?
  status    String   @default("Registered") // Active, Registered, Dormant, Inactive
  website   String?
  facebook  String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isHub     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Independent co-ops, unions, and living-wage employers not in resilience.foundation's
// TREK pipeline — added manually (often via AI-extracted paste) so they still count
// toward the cooperative-network/housing/worker-power stats and public directory.
model ExternalOrg {
  id               String   @id @default(cuid())
  name             String
  website          String?
  email            String?
  phone            String?
  rawInput         String   // original pasted text this entry was created from — kept for audit/re-extraction
  notes            String?  // admin-edited description, shown publicly if published

  isCoop           Boolean  @default(false)
  isUnion          Boolean  @default(false)
  isWorkerOwned    Boolean  @default(false)
  offersLivingWage Boolean  @default(false)
  ownsHousing      Boolean  @default(false)
  occupantCount    Int?     // only meaningful if ownsHousing
  employeeCount    Int?

  published        Boolean  @default(false) // draft until reviewed — only published orgs count toward public stats/directory
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Civic Advocacy log — council contacts, testimony, endorsements, anchor meetings
model AdvocacyEntry {
  id        String   @id @default(cuid())
  entryType String   // council_contact | testimony | endorsement | anchor_meeting
  summary   String   // one-line shown publicly
  detail    String?  // admin-only context
  who       String?  // council member, institution, candidate, body
  date      DateTime
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// LANSING RAISED ME — History / Map / Timeline / Relationship
// ============================================================

// Master node: every person, org, property, institution, media outlet
model Entity {
  id          Int      @id @default(autoincrement())
  entityType  String   // person | organization | property | institution | media

  name        String
  altNames    String[] // alternative / former names

  description String?

  // Geographic
  address     String?
  city        String?
  state       String?
  zip         String?
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  geoSource   String?  // google_geocode | manual | approximate

  // Temporal
  activeStart DateTime?
  activeEnd   DateTime?

  // Source
  sourceTier  String   @default("RC") // S | FM | RC | RHN
  sourceNote  String?
  sourceUrl   String?

  // Domain tags (housing, food, governance, etc.)
  domains     String[]

  // Narrative / visualization
  bookChapter    String?
  timelineEntry  Boolean @default(false)
  mapPin         Boolean @default(true)
  familyStory    Boolean @default(false)

  // Not-public entries are admin-only — excluded from every public query and total
  isPublic    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  fromRelations  EntityRelation[] @relation("FromEntity")
  toRelations    EntityRelation[] @relation("ToEntity")
  entityEvents   EntityEvent[]
  fromFlows      DollarFlow[]     @relation("FromEntity")
  toFlows        DollarFlow[]     @relation("ToEntity")
  docs           SourceDoc[]      @relation("EntityDocs")

  @@map("entities")
}

// Every datestamped occurrence — vote, sale, birth, death, strike, opening
model HistoryEvent {
  id          Int      @id @default(autoincrement())

  title       String
  description String?

  eventType   String   // civic | family | national | environmental | labor | legal | financial | political | physical

  // Temporal
  eventDate     DateTime?
  eventDateEnd  DateTime?
  datePrecision String   @default("day") // day | month | year | decade | approximate

  // Geographic
  address     String?
  city        String?
  state       String?
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)

  // Financial
  dollarAmount BigInt?  // in cents
  dollarNote   String?

  // Source
  sourceTier  String   @default("RC")
  sourceNote  String?
  sourceUrl   String?

  // Domain tags
  domains     String[]

  // Visualization
  timelineVisible Boolean @default(true)
  mapVisible      Boolean @default(true)
  significance    Int     @default(3) // 1=minor … 5=defining

  // Narrative
  bookChapter  String?
  familyStory  Boolean @default(false)
  era          String? // colonial | industrial_rise | labor | highway | deindustrial | repackaging | current

  // Not-public entries are admin-only — excluded from every public query and total
  isPublic    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  entityEvents   EntityEvent[]
  eventContexts  EventContext[]
  flowEvents     DollarFlow[]
  docs           SourceDoc[]    @relation("EventDocs")

  @@map("events")
}

// Edge between any two entities, or between entity and event
model EntityRelation {
  id              Int      @id @default(autoincrement())

  fromEntityId    Int?
  fromEntity      Entity?      @relation("FromEntity", fields: [fromEntityId], references: [id])

  toEntityId      Int?
  toEntity        Entity?      @relation("ToEntity", fields: [toEntityId], references: [id])

  relationshipType String   // parent_of | employed_by | board_member_of | sold_to | … (see spec)

  description     String?

  // Temporal
  startDate       DateTime?
  endDate         DateTime?

  // Source
  sourceTier      String   @default("RC")
  sourceNote      String?
  sourceUrl       String?

  // Conflict flag
  isConflict      Boolean  @default(false)
  conflictNote    String?

  // Visualization
  weight          Int      @default(1) // 1-5
  visibleOnMap    Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("relationships")
}

// Background bands — Great Depression, labor era, deindustrialization, etc.
model ContextLayer {
  id          Int      @id @default(autoincrement())

  name        String
  description String?

  layerType   String   // national | state | local | family | economic | labor | racial

  startDate   DateTime
  endDate     DateTime?

  scope       String   @default("lansing") // national | michigan | lansing | neighborhood | family

  // Source
  sourceTier  String   @default("S")
  sourceNote  String?
  sourceUrl   String?

  // Visualization
  colorCode   String?  // hex, e.g. '#8B0000'
  opacity     Decimal? @db.Decimal(3, 2)

  createdAt   DateTime @default(now())

  eventContexts EventContext[]

  @@map("context_layers")
}

// Junction: events ↔ context layers
model EventContext {
  eventId     Int
  event       HistoryEvent @relation(fields: [eventId], references: [id])
  contextId   Int
  context     ContextLayer @relation(fields: [contextId], references: [id])

  @@id([eventId, contextId])
  @@map("event_context")
}

// Junction: entities ↔ events (with role)
model EntityEvent {
  entityId    Int
  entity      Entity       @relation(fields: [entityId], references: [id])
  eventId     Int
  event       HistoryEvent @relation(fields: [eventId], references: [id])
  role        String       // victim | owner | buyer | seller | mayor | employee | family_member | etc.

  @@id([entityId, eventId, role])
  @@map("entity_events")
}

// Source documents — obituaries, news articles, FOIA responses, court decisions
model SourceDoc {
  id              Int      @id @default(autoincrement())

  title           String
  docType         String?  // obituary | property_record | newspaper | court_decision | foia_response | investigation | photo | map | video

  sourceName      String?
  sourceUrl       String?
  publicationDate DateTime?

  sourceTier      String   @default("S")

  entityId        Int?
  entity          Entity?       @relation("EntityDocs", fields: [entityId], references: [id])
  eventId         Int?
  event           HistoryEvent? @relation("EventDocs", fields: [eventId], references: [id])

  excerpt         String?
  notes           String?

  createdAt       DateTime @default(now())

  @@map("documents")
}

// Financial transactions — public investment, private extraction, tax abatements, etc.
model DollarFlow {
  id            Int      @id @default(autoincrement())

  description   String

  flowType      String?  // public_investment | private_extraction | public_cleanup | sale | subsidy | tax_abatement | developer_fee | eminent_domain | remediation | grant | penalty

  amountCents   BigInt?

  fromEntityId  Int?
  fromEntity    Entity?      @relation("FromEntity", fields: [fromEntityId], references: [id])
  toEntityId    Int?
  toEntity      Entity?      @relation("ToEntity", fields: [toEntityId], references: [id])
  eventId       Int?
  event         HistoryEvent? @relation(fields: [eventId], references: [id])

  flowDate      DateTime?
  flowDateEnd   DateTime?

  isPublicCost  Boolean  @default(false)
  isPrivateGain Boolean  @default(false)

  sourceTier    String   @default("RC")
  sourceNote    String?
  sourceUrl     String?

  // Not-public entries are admin-only — excluded from every public query and total
  isPublic      Boolean  @default(true)

  createdAt     DateTime @default(now())

  @@map("dollar_flows")
}

// Pattern Language for Polycentric Governance — 28 patterns across 4 scales
model Pattern {
  id          String   @id @default(cuid())
  slug        String   @unique
  number      Int
  name        String
  scale       String   // movement | domain | institution | practice
  problem     String   @db.Text
  forces      String   @db.Text
  solution    String   @db.Text
  linksUp     String[] // slugs of patterns this one completes
  linksDown   String[] // slugs of patterns that complete this one
  caseRefs    String[] // BoardCaseStudy slugs this pattern evidences
  // [{label, url, note}]
  externalLinks Json   @default("[]")
  status      String   @default("tested") // tested | untested | partial
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Ask Lansing.love — chat log and site config
model ChatLog {
  id          String   @id @default(cuid())
  userMessage String
  botResponse String   @db.Text
  flagged     Boolean  @default(false)
  adminNote   String?
  promoted    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SiteConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Zone 3 — Ownership Check: 4 standing questions updated quarterly by humans
model OwnershipCheck {
  id         String   @id @default(cuid())
  sortOrder  Int      @default(0)
  question   String
  answer     String   @default("")
  reviewedAt DateTime?
  updatedBy  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
